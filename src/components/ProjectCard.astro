---
// One project card. "featured" cards are larger; "compact" is used in the More Projects grid.
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  variant?: "featured" | "compact";
}

const { project, variant = "featured" } = Astro.props;
const { title, summary, tags, repo, repoNote, demo, demoLabel, note, comingSoon } = project;
const Heading = variant === "featured" ? "h3" : "h4";
---

<article class:list={["card", variant, { soon: comingSoon }]}>
  <div class="card-top">
    <Heading class="card-title">{title}</Heading>
    {comingSoon && <span class="badge badge-soon">Coming soon</span>}
    {note && <span class="badge">{note}</span>}
  </div>

  <p class="card-summary">{summary}</p>

  <ul class="tag-list" aria-label="Built with">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>

  {(demo || repo || repoNote) && (
    <div class="card-links">
      {demo && (
        <a href={demo} class="card-link">
          {demoLabel ?? "Live demo"}
          <span class="visually-hidden"> for {title}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {repo && (
        <a href={repo} class="card-link">
          Code on GitHub
          <span class="visually-hidden"> for {title}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {repoNote && <span class="card-note">{repoNote}</span>}
    </div>
  )}
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  /* No lift on hover: the card itself isn't a link, so it shouldn't act like one. */
  .card:hover {
    box-shadow: var(--shadow-hover);
  }

  .card.compact {
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
  }

  .card.compact:hover {
    border-color: var(--text-muted);
  }

  /* The reserved slot is see-through glass, so it reads as "not filled yet". */
  .card.soon {
    border-style: dashed;
    background: color-mix(in srgb, var(--surface) 35%, transparent);
    box-shadow: none;
  }

  .card.soon:hover {
    box-shadow: none;
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .card-title {
    font-size: 1.25rem;
    margin-right: auto;
  }

  .compact .card-title {
    font-size: 1.05rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .badge-soon {
    background: var(--soon-soft);
    color: var(--soon);
  }

  .card-summary {
    color: var(--text-muted);
    flex-grow: 1;
  }

  .compact .card-summary {
    font-size: 0.95rem;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-4);
  }

  /* Tall enough (44px) to tap easily on a phone. */
  .card-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* Plain text, so it lines up with the links but doesn't look clickable. */
  .card-note {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
