---
// One project card. "featured" cards are larger; "compact" is used in the More Projects grid.
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  variant?: "featured" | "compact";
}

const { project, variant = "featured" } = Astro.props;
const { title, summary, tags, repo, repoNote, demo, demoLabel, note, comingSoon } = project;
const Heading = variant === "featured" ? "h3" : "h4";
---

<article class:list={["card", variant, { soon: comingSoon }]}>
  <span class="card-bracket card-bracket-tl" aria-hidden="true"></span>
  <span class="card-bracket card-bracket-br" aria-hidden="true"></span>
  <div class="card-top">
    <Heading class="card-title">{title}</Heading>
    {comingSoon && <span class="badge badge-soon">Coming soon</span>}
    {note && <span class="badge">{note}</span>}
  </div>

  <p class="card-summary">{summary}</p>

  <ul class="tag-list" aria-label="Built with">
    {tags.map((tag) => <li>{tag}</li>)}
  </ul>

  {(demo || repo || repoNote) && (
    <div class="card-links">
      {demo && (
        <a href={demo} class="card-link">
          {demoLabel ?? "Live demo"}
          <span class="visually-hidden"> for {title}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {repo && (
        <a href={repo} class="card-link">
          Code on GitHub
          <span class="visually-hidden"> for {title}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
      {repoNote && <span class="card-note">{repoNote}</span>}
    </div>
  )}
</article>

<style>
  /* Glossy glass: a see-through fill that blurs what's behind it, a thin
     border that's brighter along the top (light catching the edge), and a
     soft diagonal sheen across the top-left corner. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    background:
      linear-gradient(140deg, var(--glass-sheen) 0%, transparent 38%),
      var(--glass-solid);
    border: 1px solid var(--glass-border);
    border-top-color: var(--glass-edge);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  /* HUD corner brackets: a quiet technical flourish on hover/focus, not a
     permanent fixture, so they never compete with the card's content. */
  .card-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid var(--brand);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  .card-bracket-tl {
    top: -1px;
    left: -1px;
    border-right: none;
    border-bottom: none;
    border-top-left-radius: var(--radius-sm);
  }

  .card-bracket-br {
    bottom: -1px;
    right: -1px;
    border-left: none;
    border-top: none;
    border-bottom-right-radius: var(--radius-sm);
  }

  .card:hover .card-bracket,
  .card:focus-within .card-bracket {
    opacity: 0.85;
  }

  .card.soon .card-bracket {
    display: none;
  }

  /* Only go see-through where the browser can blur behind the card. Otherwise
     the near-solid fill above stays, so it still clearly reads as a card.
     Safari's "-webkit-" version needs its own block: the build tool drops it
     when it sits next to the standard one. */
  @supports (backdrop-filter: blur(1px)) {
    .card {
      background:
        linear-gradient(140deg, var(--glass-sheen) 0%, transparent 38%),
        var(--glass-fill);
      backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    }
  }

  @supports (-webkit-backdrop-filter: blur(1px)) {
    .card {
      background:
        linear-gradient(140deg, var(--glass-sheen) 0%, transparent 38%),
        var(--glass-fill);
      -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(140%);
    }
  }

  /* No lift on hover: the card itself isn't a link, so it shouldn't act like one.
     Just a slightly deeper shadow and a brighter edge. */
  .card:hover {
    box-shadow: var(--shadow-hover);
    border-color: color-mix(in srgb, var(--glass-edge) 60%, var(--glass-border));
    border-top-color: var(--glass-edge);
  }

  /* Smaller cards: same glass, a quieter sheen and a lighter shadow. */
  .card.compact {
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background-image: linear-gradient(180deg, color-mix(in srgb, var(--glass-edge) 18%, transparent), transparent 45%);
  }

  /* The reserved slot stays clearly different: dashed, thinner glass, no shine. */
  .card.soon {
    border-style: dashed;
    border-color: var(--text-muted);
    background: color-mix(in srgb, var(--surface) 30%, transparent);
    box-shadow: none;
  }

  .card.soon:hover {
    box-shadow: none;
    border-color: var(--text-muted);
  }

  /* Visitors who ask for less transparency get solid cards. */
  @media (prefers-reduced-transparency: reduce) {
    .card,
    .card.compact,
    .card.soon {
      background: var(--surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }

  .card-title {
    font-size: 1.25rem;
    margin-right: auto;
  }

  .compact .card-title {
    font-size: 1.05rem;
  }

  .badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .badge-soon {
    background: var(--soon-soft);
    color: var(--soon);
  }

  .card-summary {
    color: var(--text-muted);
    flex-grow: 1;
  }

  .compact .card-summary {
    font-size: 0.95rem;
  }

  .card-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-4);
  }

  /* Tall enough (44px) to tap easily on a phone. */
  .card-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  /* Plain text, so it lines up with the links but doesn't look clickable. */
  .card-note {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
