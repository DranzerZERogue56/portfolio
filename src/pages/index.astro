---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";
import { featured, more } from "../data/projects";
import { intro, facts } from "../data/about";
---

<Layout>
  <section class="hero" aria-labelledby="hero-title" data-hero>
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-glow"></div>
    </div>
    <div class="container">
      <p class="eyebrow reveal" style="--i: 0">Portfolio</p>
      <h1 id="hero-title" class="reveal-mask">{site.name}</h1>
      <p class="tagline reveal" style="--i: 1">{site.tagline}</p>
      <div class="hero-actions reveal" style="--i: 2">
        <a class="btn btn-primary magnetic" href={site.github} rel="me">View GitHub</a>
        <a class="btn" href="#projects">See projects</a>
        {site.resumeUrl ? (
          <a class="btn" href={site.resumeUrl}>Résumé (PDF)</a>
        ) : (
          <span class="btn" aria-disabled="true">Résumé — coming soon</span>
        )}
      </div>
    </div>
  </section>

  <section id="projects" class="section" aria-labelledby="featured-title">
    <div class="project-glows" aria-hidden="true">
      <div class="pglow pglow-1"></div>
      <div class="pglow pglow-2"></div>
      <div class="pglow pglow-3"></div>
    </div>
    <div class="container">
      <header class="section-header reveal">
        <h2 id="featured-title">Featured projects</h2>
        <p>The builds I'm proudest of — AI tooling, mobile apps, and games.</p>
      </header>
      <ul class="grid grid-featured" role="list">
        {featured.map((project, i) => (
          <li class="reveal" style={`--i: ${i % 3}`}><ProjectCard project={project} /></li>
        ))}
      </ul>

      {/* Closed by default to keep the page short. Built-in <details>, so it
          works without JavaScript and find-in-page (Ctrl+F) opens it. */}
      <details class="more reveal">
        <summary>
          <h3 class="more-title" id="more-title">More projects</h3>
          <span class="more-count">{more.length} projects</span>
          <svg class="more-chevron" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <ul class="grid grid-more" role="list" aria-labelledby="more-title">
          {more.map((project, i) => (
            <li class="reveal" style={`--i: ${i % 4}`}><ProjectCard project={project} variant="compact" /></li>
          ))}
        </ul>
      </details>
    </div>
  </section>

  <section id="about" class="section section-alt" aria-labelledby="about-title">
    <div class="container">
      <header class="section-header reveal">
        <h2 id="about-title">About</h2>
      </header>
      <div class="prose reveal" style="--i: 1">
        {intro.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="about-facts">
        {facts.map((group, i) => (
          <div class="fact-group reveal" style={`--i: ${i % 2}`}>
            <h3>{group.heading}</h3>
            <ul role="list">
              {group.items.map((item) => (
                <li>
                  <p class="fact-title">
                    <span>{item.title}</span>
                    {item.when && <span class="fact-when">{item.when}</span>}
                  </p>
                  {item.detail && <p class="fact-detail">{item.detail}</p>}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container narrow">
      <header class="section-header reveal">
        <h2 id="contact-title">Get in touch</h2>
        <p>The best way to reach me or see what I'm working on is GitHub.</p>
      </header>
      <div class="hero-actions reveal" style="--i: 1">
        <a class="btn btn-primary magnetic" href={site.github} rel="me">github.com/{site.githubHandle}</a>
        {site.email && <a class="btn" href={`mailto:${site.email}`}>Email me</a>}
        {site.resumeUrl ? (
          <a class="btn" href={site.resumeUrl}>Résumé (PDF)</a>
        ) : (
          <span class="btn" aria-disabled="true">Résumé — coming soon</span>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(4rem, 10vw, 7rem) var(--space-12);
  }

  /* A soft light that follows the cursor (set via --mx/--my). The grid itself
     now sits behind the whole page (see Layout.astro). */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    inset: -30%;
    background: radial-gradient(
      420px circle at var(--mx, 25%) var(--my, 28%),
      var(--glow),
      transparent 62%
    );
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-glow {
      animation: glow-drift 14s ease-in-out infinite alternate;
    }
  }

  /* Idle drift when the cursor isn't moving the glow (vars stay at defaults). */
  @keyframes glow-drift {
    from {
      transform: translate3d(-3%, -2%, 0);
    }
    to {
      transform: translate3d(4%, 3%, 0);
    }
  }

  /* The stronger red (darker in light mode, lighter in dark mode): this small
     label sits on the hero's red glow, and the regular red fell short there. */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.8rem + 3.5vw, 4rem);
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.4rem);
    color: var(--text-muted);
    max-width: 38ch;
    margin-top: var(--space-4);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  #contact .hero-actions {
    margin-top: 0;
  }

  /* Soft colour glows behind the project cards, so the see-through cards have
     something to show. Each is a big radial gradient (already soft, so no blur
     filter needed). They drift very slowly, and not at all with reduced motion. */
  #projects {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .project-glows {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .pglow {
    position: absolute;
    width: min(900px, 110vw);
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .pglow-1 {
    left: 18%;
    top: 22%;
    background: radial-gradient(closest-side, var(--glow-1), transparent);
  }

  .pglow-2 {
    left: 78%;
    top: 62%;
    background: radial-gradient(closest-side, var(--glow-2), transparent);
  }

  .pglow-3 {
    left: 62%;
    top: 20%;
    width: min(700px, 90vw);
    background: radial-gradient(closest-side, var(--glow-3), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pglow-1 {
      animation: pglow-drift 38s ease-in-out infinite alternate;
    }
    .pglow-2 {
      animation: pglow-drift 46s ease-in-out -12s infinite alternate-reverse;
    }
  }

  @keyframes pglow-drift {
    from {
      transform: translate(-50%, -50%);
    }
    to {
      transform: translate(-44%, -54%);
    }
  }

  .grid {
    display: grid;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .grid-featured {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }

  .grid-more {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-4);
  }

  /* "More projects" bar: the whole row is the button that opens the list. */
  .more {
    margin-top: var(--space-16);
  }

  .more summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 3.5rem;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--glass-border);
    border-top-color: var(--glass-edge);
    border-radius: var(--radius);
    background: var(--glass-solid);
    box-shadow: var(--shadow);
    cursor: pointer;
    list-style: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    border-color: var(--text-muted);
    box-shadow: var(--shadow-hover);
  }

  .more-title {
    font-size: 1.25rem;
    margin-right: auto;
  }

  .more-count {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .more-chevron {
    flex-shrink: 0;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }

  .more[open] .more-chevron {
    transform: rotate(180deg);
  }

  .more[open] summary {
    margin-bottom: var(--space-6);
  }

  /* A frosted band: the grid shows faintly through it. */
  .section-alt {
    background: color-mix(in srgb, var(--surface) 60%, transparent);
    border-block: 1px solid var(--border);
  }

  .narrow {
    max-width: 760px;
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    font-size: 1.1rem;
    max-width: 65ch;
  }

  /* Experience / Education / Skills / Leadership: two columns on wide
     screens, one on phones. */
  .about-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: var(--space-6);
    margin-top: var(--space-12);
  }

  .fact-group {
    padding: var(--space-6);
    border: 1px solid var(--glass-border);
    border-top-color: var(--glass-edge);
    border-radius: var(--radius);
    background: var(--glass-solid);
    box-shadow: var(--shadow);
  }

  .fact-group h3 {
    font-size: 1.05rem;
    margin-bottom: var(--space-4);
  }

  .fact-group ul {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fact-title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--space-3);
    font-weight: 600;
  }

  .fact-when {
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 400;
    white-space: nowrap;
  }

  .fact-detail {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
